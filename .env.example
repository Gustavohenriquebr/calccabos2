# CalcCabos - exemplo de variaveis de ambiente
#
# Copie apenas as variaveis necessarias para o servico correspondente.
# Nunca versionar arquivos .env reais.

# -----------------------------------------------------------------------------
# Frontend React/Vite - frontend/.env
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000

# -----------------------------------------------------------------------------
# Backend Node/Express - backend-node/.env
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://SEU-FRONTEND.vercel.app
PYTHON_SERVICE_URL=http://localhost:8001
PYTHON_SERVICE_PUBLIC_URL=
MONGODB_URI=mongodb+srv://<usuario>:<senha>@<cluster>/<database>?retryWrites=true&w=majority
MONGODB_DB_NAME=calccabos
MONGODB_APP_NAME=CalcCabos API
MONGODB_TLS=true
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
SESSION_SECRET=troque-por-outro-segredo-longo-e-aleatorio
JWT_EXPIRES=7d
PYTHON_CALC_TIMEOUT_MS=120000
PYTHON_BATCH_CALC_TIMEOUT_MS=180000
PYTHON_AGENT_TIMEOUT_MS=180000
PYTHON_REPORT_TIMEOUT_MS=180000
PYTHON_IMPORT_CALC_BATCH_SIZE=50
IMPORT_CONFIRM_LOCK_TIMEOUT_MS=600000

# -----------------------------------------------------------------------------
# Backend Python/FastAPI - backend/.env
# -----------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8001
DOCS_ENABLED=true
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://SEU-FRONTEND.vercel.app
DATABASE_URL=sqlite:///./calc.db
SECRET_KEY=troque-por-um-segredo-longo-e-aleatorio
ACCESS_TOKEN_EXPIRE_MINUTES=10080
API_V1_PREFIX=/api/v1
ENVIRONMENT=development

# -----------------------------------------------------------------------------
# Cloudinary - futuro bloco de uploads
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=calccabos

# -----------------------------------------------------------------------------
# IA auxiliar - backend-node/.env
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-5.6
AI_MAX_TOKENS=900
AI_RATE_LIMIT=30
AI_TIMEOUT_MS=45000

# -----------------------------------------------------------------------------
# Deploy - preencher somente nos paineis da Vercel/Render quando aplicavel
# -----------------------------------------------------------------------------
VERCEL_PROJECT_ID=
RENDER_SERVICE_ID=
RENDER_PYTHON_SERVICE_ID=
