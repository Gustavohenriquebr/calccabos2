# Backend Node.js environment variables
# MongoDB connection string (Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/calcabos?retryWrites=true&w=majority

# Port for Express server
PORT=8000

# URL do engine FastAPI
# Local: http://localhost:8001
# Render: https://URL-DO-BACKEND-PYTHON.onrender.com
# Nunca usar localhost/127.0.0.1 em producao Render com servicos separados.
PYTHON_SERVICE_URL=http://localhost:8001
PYTHON_SERVICE_PUBLIC_URL=

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://SEU-FRONTEND.vercel.app

# JWT secret for auth
JWT_SECRET=your_secret_key_here

# Token expiration (e.g., 7d)
JWT_EXPIRES=7d
