# Backend Node.js environment variables
# MongoDB connection string (Atlas)
# Obrigatoria em producao. Em desenvolvimento, se ausente, o backend usa MongoDB Memory Server.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/calcabos?retryWrites=true&w=majority
MONGODB_DB_NAME=calccabos
MONGODB_APP_NAME=CalcCabos API
MONGODB_TLS=true

# Port for Express server. Render fornece PORT automaticamente.
PORT=8000

# URL do engine FastAPI
# Local: http://localhost:8001
# Render staging: https://calccabos-staging-python.onrender.com
# Nunca usar localhost/127.0.0.1 em producao Render com servicos separados.
PYTHON_SERVICE_URL=http://localhost:8001
PYTHON_SERVICE_PUBLIC_URL=

# CORS allowed origins (comma separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://SEU-FRONTEND.vercel.app,https://SEU-FRONTEND-git-staging-SEU-USUARIO.vercel.app

# Auth secrets
# Em producao, JWT_SECRET e SESSION_SECRET sao obrigatorios e devem ter pelo menos 32 caracteres.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
SESSION_SECRET=replace-with-another-long-random-secret-at-least-32-chars

# Token expiration (e.g., 7d)
JWT_EXPIRES=7d

# API protection limits/timeouts
PYTHON_CALC_TIMEOUT_MS=120000
PYTHON_BATCH_CALC_TIMEOUT_MS=180000
PYTHON_AGENT_TIMEOUT_MS=180000
PYTHON_REPORT_TIMEOUT_MS=180000
PYTHON_IMPORT_CALC_BATCH_SIZE=50
IMPORT_CONFIRM_LOCK_TIMEOUT_MS=600000

# IA auxiliar segura
# AI_ENABLED=false mantem o endpoint com erro controlado/fallback local.
# Para desenvolvimento sem API real, use AI_ENABLED=true e AI_PROVIDER=mock.
AI_ENABLED=false
AI_PROVIDER=openai
OPENAI_API_KEY=
AI_MODEL=gpt-5.6
AI_MAX_TOKENS=900
AI_RATE_LIMIT=30
AI_TIMEOUT_MS=45000
