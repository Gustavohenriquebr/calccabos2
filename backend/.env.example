# FastAPI engine (Render/local)
PORT=8001
HOST=0.0.0.0
DOCS_ENABLED=false
ENVIRONMENT=development
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080
DATABASE_URL=sqlite:///./calc.db

# CORS (origens separadas por virgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://SEU-FRONTEND.vercel.app

# Chaves de IA (preencher no deploy)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY
GOOGLE_API_KEY=YOUR_GOOGLE_API_KEY
GROQ_API_KEY=YOUR_GROQ_API_KEY
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY

# Selecao de modelos (opcional)
GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash
GROQ_MODELS=llama-3.1-8b-instant
OPENROUTER_MODELS=openrouter/free,nvidia/nemotron-3-super:free,openai/gpt-oss-120b:free
